<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/solina_persian_calendar_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/solina_persian_calendar_widget_background">

    <TextView
        android:id="@+id/solina_persian_calendar_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/solina_persian_calendar_caption"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/solina_persian_calendar_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="۱۴۰۵/۰۱/۰۱"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="19sp"
        android:textStyle="bold" />
</LinearLayout>
